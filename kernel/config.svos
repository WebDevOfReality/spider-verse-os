# Weaver config fragment — applied on top of `make tinyconfig`.
# tinyconfig is "minimal" by disabling whole *subsystems* (TTY, ELF exec,
# futex, epoll...): anything gated behind a vanished option is silently
# dropped by olddefconfig. So this fragment must (a) re-enable the syscall
# layer musl/busybox require, then (b) add Weaver's hardware needs.
# The settled result is committed as config-6.1.188-svos.

# --- syscall layer: musl/busybox hard requirements (EXPERT-off in tiny) ---
CONFIG_BINFMT_ELF=y          # or /init never execs
CONFIG_BINFMT_SCRIPT=y       # #!/bin/sh support for /init

# Stage 2d: bootable artifacts (squashfs root, ISO boot)
CONFIG_MISC_FILESYSTEMS=y    # menu gate for squashfs (allnoconfig kills it)
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y        # losetup for squashfs
CONFIG_ISO9660_FS=y          # El Torito ISO boot
CONFIG_RD_XZ=y

# Stage 3: nebula lab (FAT disk carries nebula+certs into the guest)
CONFIG_FAT_FS=y              # menu gate lives in fs/Kconfig (DOS/FAT)
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y    # vfat default codepage
CONFIG_NLS_ISO8859_1=y       # vfat default iocharset
# Stage 5: k3s (namespaces, cgroups, netfilter, overlayfs...)
CONFIG_SYSVIPC=y             # k8s IPC namespaces
CONFIG_POSIX_MQUEUE=y        # container runtime needs mqueue
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y              # container net namespaces
CONFIG_USER_NS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_INOTIFY_USER=y
CONFIG_PROC_SYSCTL=y
CONFIG_OVERLAY_FS=y          # container rootfs
CONFIG_BRIDGE=y              # flannel/cni
CONFIG_VETH=y
CONFIG_VXLAN=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_DUMMY=y               # kubelet cni plumbing
CONFIG_MACVLAN=y
CONFIG_KEYS=y                # kubelet ContainerManager: /proc/sys/kernel/keys/*
CONFIG_NF_TABLES=y           # iptables-nft inside k3s
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=y
CONFIG_NFT_CHAIN_NAT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_COUNTER=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_FIB_IPV4=y

# Stage 3 (still needed): nebula tun device
CONFIG_TUN=y                 # nebula's tun/tap device (drivers/net)
CONFIG_NET_CORE=y            # menu gate for TUN (allnoconfig kills it too)
CONFIG_FUTEX=y               # musl threads/locks
CONFIG_EPOLL=y               # event loops (nebula, later k3s)
CONFIG_POSIX_TIMERS=y
CONFIG_TIMERFD=y
CONFIG_SHMEM=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_TTY=y                 # serial console lives under TTY

# --- console: 8250 UART on ttyS0 (QEMU -nographic) ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK=y

# --- 64-bit x86 baseline ---
CONFIG_64BIT=y
CONFIG_SMP=y

# --- PCI + virtio: QEMU's virtual devices ---
# VIRTIO_MENU is the menu gate for the drivers; without it set,
# VIRTIO_PCI/BLK/NET are unreachable (allnoconfig answers menus "no")
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# --- network stack: the Web of Reality substrate ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y

# --- initramfs + boot basics ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BLK_DEV=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# --- cgroups v2: k3s (Stage 5) requirement ---
CONFIG_CGROUPS=y

# --- pin intent: no modules, no swap, no debug bloat ---
CONFIG_MODULES=n
CONFIG_SWAP=n
CONFIG_DEBUG_KERNEL=n