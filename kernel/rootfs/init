#!/bin/sh
# /init — PID 1 entry point for the Weaver initramfs (Stage 2b).
#
# The kernel execs exactly this file as PID 1. svos-init (a static ELF
# built from init/svos-init.c) does the real work: mount pseudo-fs, open
# the console, spawn+respawn a shell, reap orphans, never exit.
#
# Why a shim instead of making /init the ELF itself? It keeps the entry
# point debuggable (swap to busybox init for A/B testing by editing one
# line) and lets us print which init is running before handing off.

/bin/busybox mkdir -p /proc /sys /dev /tmp /run /sbin
exec /sbin/svos-init