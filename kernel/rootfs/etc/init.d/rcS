#!/bin/sh
# rcS — system boot script, run once by busybox init (Stage 2a).
# Kept deliberately simple: mount the world, print the banner.
# svos-init (2b) takes over everything except rcS/rcK themselves.

/bin/mount -t proc none /proc
/bin/mount -t sysfs none /sys
/bin/mount -t devtmpfs none /dev
/bin/mkdir -p /tmp /run
/bin/mount -t tmpfs none /tmp
# PID 1 (busybox init) opened the console before /dev existed —
# re-bind stdio of anything spawned from rcS now that it exists.
exec </dev/console >/dev/console 2>&1

hostname weaver

echo
echo '        .-"""-.        Spider-Verse OS'
echo '       / _   _ \       ==========================='
echo '      | (o) (o) |      Weaver initramfs (Stage 2)'
echo '      |    ^    |'
echo '       \  ---  /       init: busybox | libc: musl'
echo '        `-----`        userland: busybox'
echo '      web-spinner'
echo
echo "weaver: kernel $(uname -r), pid1 = $(cat /proc/1/comm)"